provider.tf

provider "aws" {
  region     = ""
  access_key = ""
  secret_key = ""
}

main.tf

module "ec2" {
	source = "./modules/ec2"
	ami = "ami-0fef201115eefe936"
	instance_type="t3.micro"
	name = "web_app"
}

module "s3" {
	source = "./modules/s3"
	bucket = "basha89704"
}

modules/ec2

main.tf

variable "ami" {
	type = string
}

variable "instance_type" {
	type = string
}

variable "name" {
	type = string 
}

resource "aws_instance" "myweb" {
	ami = var.ami
	instance_type = var.instance_type
	name = var.name
}

modules/s3

main.tf

variable "bucket" {
	type = string
}
resource "aws_bucket" "my_bucket" {
	bucket = var.bucket
}
